# ============================================================
# Survey-Holic 環境変数
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# ============================================================

# --- Database (必須) ---
DATABASE_URL="file:./dev.db"

# --- AI LLM (どちらか一方、または両方) ---
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# デフォルトLLMプロバイダー: "claude" または "openai"
DEFAULT_LLM_PROVIDER="claude"

# --- Market Research (Web Scraping) ---
# Brave Search API: 無料枠2000クエリ/月 https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=""
# Google 関連検索 / Google トレンドRSSは APIキー不要（自動利用）

# --- TikTok Content Posting API ---
# TikTok for Developers でアプリを作成後、OAuth 2.0 でトークンを取得
TIKTOK_ACCESS_TOKEN=""

# スケジューラーのテスト用動画URL（公開アクセス可能なURLが必要）
TIKTOK_TEST_VIDEO_URL=""
